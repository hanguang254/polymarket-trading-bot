# ──────────────────────────────────────────────────────────────
# Polymarket Trading Bot v12.9.10 - 环境变量模板
# 复制本文件为 .env 并填入真实值:  cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════
# 1. 基础配置（必填）
# ══════════════════════════════════════════════

# Telegram 通知（可选，留空则不发通知）
# 创建 Bot: @BotFather → /newbot → 获取 TOKEN
# 获取 CHAT_ID: 给 Bot 发消息后访问 https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 钱包地址（必填）
# EOA_WALLET:   签名用的 EOA 地址（MetaMask 等钱包地址）
# PROXY_WALLET: Polymarket 代理钱包（持仓实际存储地址）
#               查看方法: 官网 → Settings → Proxy Wallet Address
EOA_WALLET=0xYourEOAWalletAddress
PROXY_WALLET=0xYourProxyWalletAddress

# SDK 签名类型（影响下单和资金来源）
# 0 = EOA 直签（资金在 EOA 钱包，默认）
# 1 = POLY_PROXY（Magic / 邮箱登录，资金在官网 Proxy 钱包）
# 2 = GNOSIS_SAFE（浏览器钱包登录官网，资金在官网 Proxy 钱包，最常见）
CLOB_SIGNATURE_TYPE=2

# 链上结算 + SDK 直连下单（PRIVATE_KEY 同时用于 CLOB SDK 签名和链上兑换）
# 注意: 此私钥控制资金安全，请勿泄露！
PRIVATE_KEY=0xYourPrivateKey
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# 自动兑换轮询间隔（秒）
# 市场结算后多久检查一次可兑换的 token，300=5分钟
REDEEM_INTERVAL=300

# Relayer 免 gas 结算（可选，不填则走自付 gas）
# 获取方式: polymarket.com → Settings → Relayer API Keys → 创建/复制 API Key
# 配置后 auto_redeem_v2.py 通过 Relayer API 提交链上交易，零 gas 费用
RELAYER_API_KEY=your-relayer-api-key-uuid
# Relayer 关联的签名地址（通常和 EOA_WALLET 一致，不填默认用 EOA_WALLET）
# RELAYER_API_KEY_ADDRESS=0xYourEOAWalletAddress

# ══════════════════════════════════════════════
# 2. 交易币种 & 数据源
# ══════════════════════════════════════════════

# 启用的交易币种（逗号分隔，可选: BTC,ETH,BNB）
# 每个币种对应一个 Polymarket 5分钟 up/down 市场
# 数据源自动适配: Chainlink RTDS + Binance WS + Pyth SSE
ENABLED_COINS=BTC,ETH

# 价格数据源优先级
# 1 = Chainlink优先（官方结算价，Polymarket 直接使用的喂价，推荐）
# 2 = Pyth优先（链上预言机，独立于 Polymarket，延迟略高）
# 无论选哪个，另一个都作为 fallback，最终 fallback 为 Binance REST
PRICE_SOURCE=1

# ══════════════════════════════════════════════
# 3. 风险控制
# ══════════════════════════════════════════════

# 日亏损上限（美元），超过后当日停止开新仓
MAX_DAILY_LOSS=40.0
# 最大同时持仓数（包括狙击线程的仓位）
MAX_OPEN_POSITIONS=3
# 最低余额保护（美元），低于此值不开新仓
MIN_BALANCE=50.0

# Kelly 仓位控制（份数 = token 数量）
# Kelly 公式根据余额、p_win、赔率自动算出最优份数
# MIN/MAX 夹住防止极端情况，实际下单份数 = clamp(kelly, MIN, MAX)
# 小资金(≤$200) 建议 1-2 份，大资金可调高
MIN_BET_SIZE=1
MAX_BET_SIZE=2
# 单笔入场最多占用余额比例（0.10=10%，$1000余额最多用$100）
MAX_ENTRY_BALANCE_PCT=0.10

# ══════════════════════════════════════════════
# 4. 狙击线程 (v12.6+)
# ══════════════════════════════════════════════
# 独立高频轮询线程，50ms 间隔扫描所有活跃市场
# 检测到 Chainlink 价格大幅偏离 PTB 时，跳过完整 AI 分析直接 FOK 下单
# 从发现机会到下单 < 2s（vs 正常路径 3-5s）

# 最高可接受 CLOB ask 价格（高于此值不买，防止买贵）
# 0.58 意味着风险 $0.58 赚 $0.42，需 58% 胜率盈亏平衡
SNIPER_MAX_PRICE=0.58
# 最小 ATR 偏离（Chainlink 价格偏离 PTB 的 ATR 倍数）
# 0.7 = 价格偏离 PTB 至少 0.7 个 ATR 才触发狙击
SNIPER_MIN_ATR=0.7
# 狙击独立 p_win shrinkage（实盘 p_win 高估 27pp，比全局 0.80 更保守）
# 模型说 p_win=0.85 → 狙击实际用 0.5 + (0.85-0.5)*0.60 = 0.71
SNIPER_P_WIN_SHRINKAGE=0.60
# 扣除手续费/spread 后的最低净 EV
# 费用典型值: 入场费~0.015 + spread~0.012 + 退出费~0.004 ≈ 0.031
SNIPER_MIN_EV=0.05
# 独立贝叶斯引擎最少更新次数（每次更新间隔~50ms，4次=200ms 观察期）
SNIPER_MIN_UPDATES=4
# 同一 epoch(5分钟) 最多狙击几个市场
# BTC/ETH 同一 5 分钟高度相关(ρ≈0.6)，默认 1 防重复风险暴露
SNIPER_MAX_PER_EPOCH=1

# ── 狙击入场保护 (v12.7.1→v12.8) ──
# v12.8 新增 Trailing TP + EV-Gate，旧保护可关闭
# ATR 动态保护：当前 ATR 偏离 ≥ 入场 ATR × 此比例时继续持有
# 例: 入场时 1.5ATR，比例 0.30 → ATR≥0.45 就继续持有
SNIPER_ATR_HOLD_RATIO=0.30
# 亏损覆盖：token 跌幅超过此值时强制放行 EV 止损（即使 ATR 保护仍有效）
SNIPER_LOSS_OVERRIDE=0.15
# 固定保护期（秒）：0=关闭（推荐，让 EV+Trailing TP 接管）
# 设 2-8 = 给交易 N 秒缓冲再启用止损检查
SNIPER_GRACE_SECONDS=0

# v12.8: Trailing Take-Profit 追踪止盈
# 利润达到 P0 阈值后激活，追踪持仓期间最高利润(HWM)
# 从峰值回撤超过动态阈值就止盈，不再让利润全吐回去
# 1=开启, 0=关闭（回退到旧 P0 双曲止盈逻辑）
TRAILING_TP_ENABLED=1

# v12.9: 时间衰减 shrinkage — 剩余时间越长，p_win shrinkage 越保守
# 剩余 ≤ 此秒数时用全量 shrinkage，超出按比例衰减
# 例: 120 → 剩余228s时 effective_shrinkage = SHRINKAGE × (120/228) = 0.37
SNIPER_SHRINK_FULL_AT=120

# v12.9: Gap 动量衰减 — 当前 gap < 近期峰值 × 此比例时跳过（动量减弱/反转信号）
SNIPER_GAP_DECAY_RATIO=0.75

# v12.9: WS 健康检查 — WS BBA age 超过此毫秒数时禁止 FOK 狙击
# WS 失效时仍允许伏击限价单（不依赖实时价格）
SNIPER_WS_MAX_AGE=5000

# v12.9: 方向确认型限价伏击 — 狙击检测到方向但ask太贵/WS失效时，
# 在贝叶斯确认方向上挂GTD限价等好价
# 1=开启, 0=关闭
SNIPER_AMBUSH=0
# 伏击固定价格（仅动态定价失效时的回退值，正常由p_win自动计算）
SNIPER_AMBUSH_PRICE=0.55
# 伏击金额（USD，Kelly自动计算仓位，此值已弃用）
SNIPER_AMBUSH_SIZE=3.0
# 伏击最低相对ATR门槛（diff_atr = gap/ATR，实盘验证<0.5信号弱）
SNIPER_AMBUSH_MIN_ATR=0.5
# 伏击最低绝对ATR门槛（美元，ATR<30市场太平静，29%胜率亏$15）
SNIPER_AMBUSH_MIN_ATR_ABS=30
# 伏击最低置信度（实盘验证conf<30%胜率极低）
SNIPER_AMBUSH_MIN_CONF=0.35
# 成交后方向校验：成交时贝叶斯置信度低于此值 → 立即卖出不建仓
SNIPER_AMBUSH_FILL_MIN_CONF=0.25
# 伏击到期时间：剩余<此秒数时撤单
SNIPER_AMBUSH_END=30
# 动态定价范围：ambush_price = p_win - edge，夹在[MIN, MAX]之间
SNIPER_AMBUSH_MIN_PRICE=0.45
SNIPER_AMBUSH_MAX_PRICE=0.75
# 从公允价值减去的利润空间（含手续费）
SNIPER_AMBUSH_EDGE=0.045
# 每个市场最大追价次数
SNIPER_AMBUSH_REPRICE_MAX=20
# GTD追价单存活秒数（过期后自动消失，防残留）
# 初始挂单用 市场结束 - AMBUSH_END 作为过期时间
SNIPER_AMBUSH_GTD_REPRICE_SEC=5
# 余额检查间隔（秒，检测成交用）
SNIPER_AMBUSH_BAL_INTERVAL=0.5
# 追价计算间隔（秒，纯内存计算不受API限速）
SNIPER_AMBUSH_REPRICE_INTERVAL=0.2

# v12.9: CL-BN价格源偏差保护 — CL滞后BN超过此ATR倍数时暂停EV止损
# CL是结算价源但推送有延迟，BN是快市场。偏差大时CL方向判断不可信
EV_SKEW_BLOCK_ATR=0.7

# ══════════════════════════════════════════════
# 5. 下注决策参数
# ══════════════════════════════════════════════

# 全局最高买入价（通用门槛，分方向参数优先）
# 买 0.55: 风险 $0.55 赚 $0.45(1.2:1); 买 0.70: 风险 $0.70 赚 $0.30(2.3:1 against)
MAX_BUY_PRICE=0.65
# 全局最低 EV（期望值 = p_win - price - costs）
MIN_EV=0.03
# 全局最低贝叶斯置信度
MIN_CONFIDENCE=0.40

# 分方向覆盖（UP/DOWN 可设不同阈值）
# UP 方向: 价格涨 → PTB 以上结算 $1，适合高波动行情
# DOWN 方向: 价格跌 → PTB 以下结算 $1
MAX_BUY_PRICE_UP=0.70
MAX_BUY_PRICE_DOWN=0.70
MIN_EV_UP=0.02
MIN_EV_DOWN=0.02
MIN_CONFIDENCE_UP=0.35
MIN_CONFIDENCE_DOWN=0.35

# ATR 偏离门槛（Chainlink 价格偏离 PTB 的 ATR 倍数）
# 越高越保守：2.0=只做极端波动, 0.7=中等波动也做
# 实盘验证: 0.7 可捕捉更多机会，配合 shrinkage 胜率 ~67%
MIN_ATR_DEVIATION=0.7

# 胜率上限（防止模型过度自信，cap 在此值）
P_WIN_CAP=0.90
# p_win shrinkage（模型系统性高估校准）
# 模型 p_win=0.85 → 实际用 0.5 + (0.85-0.5)*0.80 = 0.78
# 数值越低越保守，0.60=激进校准, 0.80=温和校准, 1.0=不校准
P_WIN_SHRINKAGE=0.80

# ══════════════════════════════════════════════
# 6. 预热 + 下注窗口（时间线）
# ══════════════════════════════════════════════
# 5分钟市场时间线:
# 0s────8s────25s────99s────100s────220s────300s
# │     │     │      │      │       │       │
# │  PTB获取  预热采样  早期窗口  晚期窗口    结算
# │         (贝叶斯)  (抢先入场) (兜底入场)

# 市场开始后多少秒进入预热（采集 Chainlink 价格 + 贝叶斯更新）
WARMUP_START_SECONDS=8
# 早期预热采样间隔（秒），在早期窗口开始前
WARMUP_SAMPLE_INTERVAL_EARLY=2
# 后段预热采样间隔（秒），进入早期窗口后采样更密
WARMUP_SAMPLE_INTERVAL_LATE=1

# ── 早期窗口 ──
# CLOB 尚未充分定价时抢先入场，token 通常更便宜
# 25-99s: PTB 已获取 + 贝叶斯积累 4+ 样本
EARLY_BET_START=25
EARLY_BET_END=99
# 至少累计多少个 warmup 样本才允许进入早期下注
EARLY_MIN_SAMPLES=4
# 早期 EV/置信度门槛（可比正常窗口低，因为 token 便宜）
EARLY_MIN_EV=0.03
EARLY_MIN_CONFIDENCE=0.35
# 可选：早期窗口按方向覆盖
EARLY_MIN_EV_UP=0.02
EARLY_MIN_EV_DOWN=0.02
EARLY_MIN_CONFIDENCE_UP=0.35
EARLY_MIN_CONFIDENCE_DOWN=0.35
# Spread 成本折算：提前平仓（止盈/止损）的概率估计
# 0.3=30% 仓位提前退出需付 spread，70% 持有到期不付
# 实际 spread_cost = raw_spread × 此值
EARLY_EXIT_RATIO=0.3

# ── 晚期窗口 ──
# 早期未触发时兜底，CLOB 定价已充分，做市商已就位
LATE_BET_START=100
LATE_BET_END=220
# 晚期至少需要多少次贝叶斯更新
LATE_MIN_UPDATES=3
# 晚期置信度低于此值直接跳过，等待重分析
LATE_LOW_CONF_THRESHOLD=0.15
# gap 穿越零轴时（价格从 PTB 上方穿到下方），只有置信度高于此值才放行
# 防止方向翻转时误入场
LATE_GAP_CROSS_ALLOW_CONF=0.60
# 样本达到此数量后，低置信度市场转入"成熟跳过"，等待波动重触发
LATE_MATURE_SAMPLE_COUNT=8
# 分析拒绝后的重分析冷却间隔（秒）
# 冷却期间贝叶斯后验持续更新，到期后用新数据重分析
ENTRY_REANALYZE_INTERVAL=20
LATE_REANALYZE_INTERVAL=20

# ══════════════════════════════════════════════
# 7. EV-Gate 止损系统（v11）
# ══════════════════════════════════════════════
# 核心止损逻辑：比较 EV(持有到结算) vs EV(立即卖出)
# P(win) 用 Chainlink oracle random-walk 模型计算，不依赖 CLOB token 价格
# 只有 EV(卖出) > EV(持有) 才触发止损，避免在方向正确时误杀

# 1=开启 EV-Gate, 0=关闭（回退到纯 ATR 止损）
ENABLE_EV_GATE=1
# 连续几轮 EV 说退出才执行（防单 tick 噪音，50ms/轮）
# 2轮 = 100ms 确认期，平衡速度和稳定性
EV_EXIT_CONFIRMATIONS=2
# P(win) 上限/下限（防止极端值）
EV_P_WIN_CAP=0.95
EV_P_WIN_FLOOR=0.02
# ATR → σ 换算比率（ATR ≈ 1.5σ，用于 random-walk 模型）
EV_ATR_SIGMA_RATIO=1.5
# 断路器: token 跌幅超此值 → 强制退出（绕过 EV 计算）
# 0.40 = 入场 $0.60 跌到 $0.36 强制止损，保留 60% 本金
EV_CIRCUIT_BREAKER_LOSS=0.40
# 断路器: oracle 数据缺失 + remaining 低于此值 + 已亏 >30% → 强制退出
EV_CIRCUIT_BREAKER_BLIND_SECS=120

# ══════════════════════════════════════════════
# 8. 止盈系统（P0 双曲 + Trailing TP v12.8）
# ══════════════════════════════════════════════
# 两层止盈：
# 层1 - P0 双曲贴现: 利润达到动态阈值时考虑止盈
#   阈值 = BASE_PROFIT × (1 + K × 剩余分钟数)
#   例: 剩余3分钟 → 0.15 × (1 + 0.15 × 3) = 21.75%
#   例: 剩余1分钟 → 0.15 × (1 + 0.15 × 1) = 17.25%
# 层2 - Trailing TP: P0达标后激活，追踪峰值利润(HWM)
#   从峰值回撤超过动态阈值就止盈
#   回撤阈值按利润等级: >30%利润回撤30%, >20%回撤35%, >15%回撤40%
#   剩余时间<120s时回撤容忍度自动收紧

# P0 基础止盈阈值（同时也是 Trailing TP 的激活门槛）
P0_BASE_PROFIT=0.15
# 双曲贴现系数（越大则远期要求越高）
P0_HYPERBOLIC_K=0.15
# 止盈阈值（兼容旧版）
PROFIT_THRESHOLD=0.15

# ══════════════════════════════════════════════
# 9. 平仓参数
# ══════════════════════════════════════════════

# 空簿回退滑点（orderbook 无数据时用 last_trade_price ± SLIPPAGE）
SLIPPAGE=0.01
# FOK 下单 HTTP 超时（秒），影响所有 CLOB API 调用
# 2s 适合止损场景（快速失败比慢速成功更重要）
FOK_TIMEOUT=2

# ══════════════════════════════════════════════
# 10. ATR 三层止损/抄底决策
# ══════════════════════════════════════════════
# 基于 Chainlink 实时价格和 ATR 偏离度，三层决策：
# ATR≥2.0(安全区) → 可抄底加仓
# 1.0≤ATR<2.0(观望区) → 持有不动
# ATR<1.0(危险区) → 考虑止损

# token 跌幅触发线（从入场价算）
# 0.15 = 入场 $0.60 跌到 $0.51 开始检查 ATR 决策
PRICE_DROP_TRIGGER=0.15
# 硬止损线：无论 ATR/方向，跌≥此值强制止损
# 0.20 = 入场 $0.60 跌到 $0.48 强制走人
PRICE_DROP_HARD_STOP=0.20
# v12.8: 绝对硬止损 — 不看方向/EV/ATR，token 跌超此值无条件止损
# 防止"方向正确但 token 崩盘"的灾难（实测 BTC DOWN -74% 案例）
# 0.40 = 入场 $0.60 跌到 $0.36 无条件走人，最坏亏 40%
ABSOLUTE_HARD_STOP=0.40
# ATR 偏离安全阈值（≥此值=抄底区，价格远离 PTB 方向正确）
ATR_SAFE_THRESHOLD=2.0
# ATR 偏离危险阈值（<此值=止损区，价格逼近 PTB）
ATR_DANGER_THRESHOLD=1.0
# 抄底加仓量 = 原仓位 × 此比例
DIP_BUY_SIZE_RATIO=0.5
# 剩余时间低于此秒数不抄底（太晚加仓没意义）
DIP_BUY_MIN_REMAINING=60

# ── ATR 衰减止损 ──
# 基于 Chainlink 实时价格，crypto 逼近 PTB 时提前退出
# ATR 降到此值以下触发（crypto 离 PTB 很近，方向信号弱）
ATR_DECAY_EXIT_THRESHOLD=0.15
# ATR 降到入场值的此比例以下触发
# 例: 入场 2.0ATR × 0.25 = 0.5，ATR 降到 0.5 以下触发
ATR_DECAY_RATIO=0.25
# 方向正确但 ATR 很低时也止损（50:50 不值得持有）
ATR_DIRECTION_CORRECT_STOP=0.5
# ATR 衰减止损需要连续确认几轮（防单点插针误杀）
ATR_DECAY_CONFIRMATIONS=3

# ── PTB Proximity Buffer ──
# crypto 在 PTB 附近时冻结方向信号，防止噪音触发止损
# 当 |crypto-PTB|/ATR < 此阈值时，视为噪音区
# 阈值随时间衰减：前2分钟=0.45ATR → 中段线性降至0.2ATR → 最后1分钟=0.1ATR
PTB_PROXIMITY_ATR=0.45
# proximity zone 内的极端安全阀：token 跌幅超过此值时强制解除保护
PTB_PROXIMITY_EXTREME_STOP=0.25

# ══════════════════════════════════════════════
# 11. 波动触发重分析
# ══════════════════════════════════════════════
# 跳过的市场（低置信度等）若价格波动超过 ATR 倍数，重新进入分析
# 1.5 = 价格变动超过 1.5 个 ATR 就重分析
REANALYZE_ATR_MULT=1.5
# 重分析冷却时间（秒）
REANALYZE_COOLDOWN=15
# 每个市场最多波动触发重分析次数
MAX_REANALYZE=3
# 晚期窗口最大分析次数（含分析拒绝+FOK重试）
MAX_TRADE_RETRIES=5

# ── 方向降级（默认关闭）──
# 开启后：底层方向信号与贝叶斯不一致时降级处理
# 关闭原因：实盘发现底层方向其实正确的单子被强行降级成错误
ENABLE_DIRECTION_DOWNGRADE=0
ATR_DOWNGRADE_THRESHOLD=0.15
