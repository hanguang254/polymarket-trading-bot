# ──────────────────────────────────────────────
# Polymarket Trading Bot - 环境变量模板
# 复制本文件为 .env 并填入真实值:  cp .env.example .env
# ──────────────────────────────────────────────

# Telegram 通知（可选，留空则不发通知）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 钱包地址（必填）
# EOA_WALLET:   签名用的 EOA 地址
# PROXY_WALLET: Polymarket 代理钱包（持仓实际存储地址，官网 Settings 里查看）
EOA_WALLET=0xYourEOAWalletAddress
PROXY_WALLET=0xYourProxyWalletAddress

# SDK 签名类型（影响下单和资金来源）
# 0 = EOA 直签（资金在 EOA 钱包，默认）
# 1 = POLY_PROXY（Magic / 邮箱登录，资金在官网 Proxy 钱包）
# 2 = GNOSIS_SAFE（浏览器钱包登录官网，资金在官网 Proxy 钱包，常见）
CLOB_SIGNATURE_TYPE=0

# 链上结算 + SDK直连下单（PRIVATE_KEY 同时用于 CLOB SDK 签名）
PRIVATE_KEY=0xYourPrivateKey
POLYGON_RPC_URL=https://polygon.api.onfinality.io/public

# 自动兑换轮询间隔（秒），默认600（10分钟）
REDEEM_INTERVAL=600

# ── 币种配置 ──
# 启用的交易币种（逗号分隔，可选: BTC,ETH,BNB）
# 每个币种对应一个 Polymarket 5分钟 up/down 市场
# 数据源自动适配: Binance WS + Chainlink RTDS + Pyth SSE
ENABLED_COINS=BTC,ETH,BNB

# ── 价格数据源 ──
# 1 = Chainlink优先（官方结算价，Polymarket直接使用，默认推荐）
# 2 = Pyth优先（链上预言机，延迟略高但独立于Polymarket）
# 无论选哪个，另一个都作为fallback，最终fallback为Binance
PRICE_SOURCE=1

# ── 风险控制 ──
MAX_DAILY_LOSS=10.0
MAX_OPEN_POSITIONS=2
MIN_BALANCE=3.0

# Kelly 仓位上下限（份数）
# Kelly公式根据余额和信号强度自动算出份数，MIN/MAX 夹住
# v12建议: 小资金(≤$200)用3-5份，降低单笔风险
# MAX_ENTRY_BALANCE_PCT: 单笔入场最多占用余额比例
MIN_BET_SIZE=3
MAX_BET_SIZE=5
MAX_ENTRY_BALANCE_PCT=0.10

# ── 下注决策 ──
# v12: MAX_BUY_PRICE 降至 0.55 — 只买便宜 token，风险回报更对称
# 买0.50: 风险$0.50 赚$0.50(1:1); 买0.75: 风险$0.75 赚$0.25(3:1 against)
MAX_BUY_PRICE=0.55
MIN_EV=0.05
MIN_CONFIDENCE=0.50
# 分方向覆盖
MAX_BUY_PRICE_UP=0.55
MAX_BUY_PRICE_DOWN=0.55
MIN_EV_UP=0.03
MIN_EV_DOWN=0.03
MIN_CONFIDENCE_UP=0.50
MIN_CONFIDENCE_DOWN=0.50
# v12: ATR门槛提高 — 只做 2.0+ ATR 大波动
MIN_ATR_DEVIATION=2.0
# 胜率上限
P_WIN_CAP=0.90
# v12: p_win shrinkage — 纠正模型系统性过度自信
# 模型说 0.85 → 校准后 0.745; 用实盘数据逐步调整
P_WIN_SHRINKAGE=0.70

# ── 预热 + 下注窗口 ──
# 预热：市场开始后尽早建立 PTB / 链上价格 / 贝叶斯状态
# WARMUP_START_SECONDS: 市场开始后多少秒进入预热；PTB API 通常很早就可用，推荐 8s
# WARMUP_SAMPLE_INTERVAL_EARLY: 早期预热采样间隔（在 early window 开始前）
# WARMUP_SAMPLE_INTERVAL_LATE: 后段预热采样间隔（进入 early window 后，采样更密）
WARMUP_START_SECONDS=8
WARMUP_SAMPLE_INTERVAL_EARLY=3
WARMUP_SAMPLE_INTERVAL_LATE=2

# 早期窗口：CLOB尚未充分定价时抢先入场（EV门槛可低于正常窗口）
# 推荐和上面的预热一起调整；太早会更容易遇到 425 Too Early
EARLY_BET_START=20
EARLY_BET_END=35
# 至少累计多少个 warmup 样本才允许进入早期下注
EARLY_MIN_SAMPLES=4
EARLY_MIN_EV=0.03
EARLY_MIN_CONFIDENCE=0.50
# 可选：早期窗口也可按方向覆盖
# EARLY_MIN_EV_UP=0.03
# EARLY_MIN_EV_DOWN=0.05
# EARLY_MIN_CONFIDENCE_UP=0.38
# EARLY_MIN_CONFIDENCE_DOWN=0.50
# Spread成本折算：提前平仓(止盈/止损/强制)的概率，持有到期不付spread
# 0.3=30%仓位提前退出，实际spread_cost = raw_spread × 此值
EARLY_EXIT_RATIO=0.3
# 晚期窗口：早期未触发时兜底
# LATE_MIN_UPDATES: 晚期至少需要多少次贝叶斯更新
# LATE_LOW_CONF_THRESHOLD: 晚期置信度低于此值直接跳过，等待重分析
# LATE_GAP_CROSS_ALLOW_CONF: gap穿越零轴时，只有贝叶斯置信度高于此值才放行
# LATE_MATURE_SAMPLE_COUNT: 样本达到此数量后，低置信度市场会转入“成熟跳过”并等待波动重触发
LATE_BET_START=100
LATE_BET_END=200
LATE_MIN_UPDATES=3
LATE_LOW_CONF_THRESHOLD=0.15
LATE_GAP_CROSS_ALLOW_CONF=0.60
LATE_MATURE_SAMPLE_COUNT=8
# 入场阶段（早期/晚期窗口）分析拒绝后的重分析冷却间隔（秒）
# 在此期间贝叶斯后验持续更新，冷却到期后用新数据重新分析
ENTRY_REANALYZE_INTERVAL=20
# 兼容旧变量名：仅在 ENTRY_REANALYZE_INTERVAL 未设置时生效
LATE_REANALYZE_INTERVAL=20

# ── EV-Gate 止损（v11）──
# 二元市场止损核心：仅当 EV(卖出) > EV(持有到结算) 时才止损
# P(win) 用 oracle random-walk 模型计算，不依赖 CLOB token 价格
ENABLE_EV_GATE=1
# 连续几轮 EV 说退出才执行（防单 tick 噪音）
EV_EXIT_CONFIRMATIONS=3
# P(win) 上限/下限
EV_P_WIN_CAP=0.95
EV_P_WIN_FLOOR=0.02
# ATR → σ 换算比率（ATR ≈ 1.5σ）
EV_ATR_SIGMA_RATIO=1.5
# 断路器: token 跌幅超此值 + remaining<90s → 强制退出（绕过 EV）
EV_CIRCUIT_BREAKER_LOSS=0.70
# 断路器: oracle 数据缺失 + remaining 低于此值 + 已亏>30% → 强制退出
EV_CIRCUIT_BREAKER_BLIND_SECS=120

# ── 平仓参数 ──
# 空簿回退滑点（last-trade-price ± SLIPPAGE，默认0.01）
SLIPPAGE=0.01

# P0 双曲贴现止盈
# 实际阈值 = BASE_PROFIT × (1 + K × 剩余分钟数)
# 首次达标跳过等$1结算条件：方向正确 + ≥3ATR + 剩余>90s
P0_BASE_PROFIT=0.20
PROFIT_THRESHOLD=0.15
P0_HYPERBOLIC_K=0.15

# HTTP 超时（秒，影响所有 CLOB API 调用）
FOK_TIMEOUT=3

# ATR 三层止损/抄底决策
# token跌幅触发线（从入场价算）
PRICE_DROP_TRIGGER=0.15
# 硬止损线：无论ATR/方向，跌≥此值强制止损
PRICE_DROP_HARD_STOP=0.25
# ATR偏离安全阈值（≥此值=抄底区）
ATR_SAFE_THRESHOLD=2.0
# ATR偏离危险阈值（<此值=止损区）
ATR_DANGER_THRESHOLD=1.0
# 抄底加仓量 = 原仓位 × 此比例
DIP_BUY_SIZE_RATIO=0.50
# 剩余时间低于此秒数不抄底
DIP_BUY_MIN_REMAINING=60

# ATR 衰减止损（基于Chainlink实时价格，crypto逼近PTB时提前退出）
# ATR降到此值以下触发（crypto离PTB很近）
ATR_DECAY_EXIT_THRESHOLD=0.5
# ATR降到入场值的此比例以下触发（如入场2.0ATR降到0.5=衰减75%）
ATR_DECAY_RATIO=0.30
# 方向正确但ATR<此值 + token跌>20% → 也触发止损（50:50不值得持有）
ATR_DIRECTION_CORRECT_STOP=0.5

# PTB Proximity Buffer（crypto在PTB附近时冻结方向信号，防止噪音触发止损）
# 当 abs(crypto-PTB)/ATR < 此阈值时，视为噪音区，不触发方向类止损
# 阈值随时间衰减：前2分钟=0.7ATR → 中段线性降至0.3ATR → 最后1分钟=0.15ATR
PTB_PROXIMITY_ATR=0.7
# proximity zone 内的极端安全阀：token跌幅超过此值时强制解除保护
PTB_PROXIMITY_EXTREME_STOP=0.50

# ── 波动触发重分析 ──
# 跳过的市场（低信心等）若价格波动超过ATR倍数，重新进入分析
REANALYZE_ATR_MULT=1.5
# 重分析冷却时间（秒）
REANALYZE_COOLDOWN=15
# 每个市场最多重分析次数（波动触发）
MAX_REANALYZE=1
# 晚期窗口最大分析次数（含分析拒绝+FOK重试，建议≥5覆盖完整窗口）
MAX_TRADE_RETRIES=5


# ATR衰减止损需要连续确认，防止单点插针误杀
ATR_DECAY_CONFIRMATIONS=3

# 默认关闭方向降级；不要再把”底层方向其实正确”的单子强行降级成错误
ENABLE_DIRECTION_DOWNGRADE=0

# 只有以后重新开启方向降级时才有意义
ATR_DOWNGRADE_THRESHOLD=0.15

# ── 狙击线程 (v12.6+) ──
# 独立200ms高频轮询线程，检测大波动时直接下单（跳过完整分析流程）
# 主线程也有动量狙击作为fallback，两条路径共享以下参数
SNIPER_THREAD_ENABLED=1
# 轮询间隔（毫秒），越低越快但CPU占用越高
SNIPER_POLL_MS=50
# 最小ATR偏离（低于此值不触发）
SNIPER_MIN_ATR=0.5
# 最高可接受CLOB ask价（高于此值不买，防止买贵）
SNIPER_MAX_PRICE=0.65
# 最低贝叶斯置信度
SNIPER_MIN_CONF=0.25
# 最低EV（v12.7: 扣除费用后的净EV）
SNIPER_MIN_EV=0.05
# p_win shrinkage（狙击独立校准，实盘p_win高估27pp）
SNIPER_P_WIN_SHRINKAGE=0.60
# 独立贝叶斯最少更新次数（减噪）
SNIPER_MIN_UPDATES=4
# 同一epoch(5分钟)最多狙击几个市场（BTC/ETH高度相关，默认1）
SNIPER_MAX_PER_EPOCH=1
# 时间窗口起点（市场开始后多少秒可以狙击）
SNIPER_EARLY=5

# ── 狙击入场保护期 (v12.5+) ──
# 狙击入场后的持仓保护，防止CLOB噪音触发误止损
# 固定保护期（秒）：兜底，ATR数据缺失时也有保护
SNIPER_GRACE_SECONDS=8
# ATR动态保护：当前ATR偏离 ≥ 入场ATR × 此比例时继续持有
SNIPER_ATR_HOLD_RATIO=0.30
# 亏损覆盖：token跌幅超过此值时强制放行止损（即使ATR仍有效）
SNIPER_LOSS_OVERRIDE=0.15
