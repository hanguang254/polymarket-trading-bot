# ──────────────────────────────────────────────────────────────
# Polymarket Trading Bot v13.0.0 - 环境变量模板
# 复制本文件为 .env 并填入真实值:  cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════
# 1. 基础配置（必填）
# ══════════════════════════════════════════════

# Telegram 通知（可选，留空则不发通知）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 钱包地址（必填）
EOA_WALLET=0xYourEOAWalletAddress
PROXY_WALLET=0xYourProxyWalletAddress

# SDK 签名类型
# 0 = EOA 直签（资金在 EOA 钱包）
# 1 = POLY_PROXY（Magic/邮箱登录，资金在 Proxy 钱包）
# 2 = GNOSIS_SAFE（浏览器钱包登录，资金在 Proxy 钱包，最常见）
CLOB_SIGNATURE_TYPE=2

# 私钥 + RPC（CLOB SDK 签名 + 链上兑换）
PRIVATE_KEY=0xYourPrivateKey
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Relayer 免 gas 结算（可选，不填则自付 gas）
RELAYER_API_KEY=your-relayer-api-key-uuid

# 自动兑换轮询间隔（秒）
REDEEM_INTERVAL=300

# ══════════════════════════════════════════════
# 2. 交易币种 & 数据源
# ══════════════════════════════════════════════

# 启用的交易币种（逗号分隔，可选: BTC,ETH,BNB,SOL,HYPE,DOGE,XRP）
ENABLED_COINS=BTC

# 价格数据源优先级
# 1 = Chainlink优先（官方结算价，推荐）
# 2 = Pyth优先（链上预言机，独立于Polymarket）
PRICE_SOURCE=1

# Binance spread calibration (Chainlink - Binance offset, then BN - adjusted PTB)
BINANCE_SPREAD_ENABLED=1
BINANCE_SPREAD_WINDOW_SEC=60
BINANCE_SPREAD_MIN_SPAN_SEC=10
BINANCE_SPREAD_BUCKET_MS=500
BINANCE_SPREAD_MAD_FLOOR=10
BINANCE_SPREAD_MIN_DIFF_ATR=0.30
BINANCE_SPREAD_ALLOW_LATEST_FALLBACK=1

# Warmup Bayesian sampling source:
# BINANCE_SPREAD = Binance price + Chainlink-Binance offset (fast default)
# BINANCE/BN = raw Binance price
# CL = Chainlink/on-chain settlement feed first
WARMUP_SAMPLING_SOURCE=BINANCE_SPREAD

# ══════════════════════════════════════════════
# 3. 风险控制
# ══════════════════════════════════════════════

# 日亏损上限（美元），超过后当日停止开仓
MAX_DAILY_LOSS=25.0
# 最大同时持仓数
MAX_OPEN_POSITIONS=2
# 最低余额保护（美元）
MIN_BALANCE=5.0

# Kelly 仓位上下限（份数）
MIN_BET_SIZE=2
MAX_BET_SIZE=8
# 单笔入场最多占用余额比例
MAX_ENTRY_BALANCE_PCT=0.20

# ══════════════════════════════════════════════
# 4. 狙击线程（v12.6+）
# ══════════════════════════════════════════════

# v14.1: 入口收敛 — taker/endgame 默认 shadow（只记信号不下单）
# 设为 1 恢复实盘（需先验证 after-fee EV 为正）
SNIPER_TAKER_LIVE=0
ENDGAME_LIVE=0
# 伏击入场要求快速方向与贝叶斯一致（1=开启，0=关闭）
AMBUSH_REQUIRE_FAST_DIR=0

# 最高可接受 CLOB ask 价格
SNIPER_MAX_PRICE=0.75
# 最小 ATR 偏离倍数
SNIPER_MIN_ATR=0.5
# 独立 p_win 收缩系数（比全局更保守）
SNIPER_P_WIN_SHRINKAGE=0.70
# 扣费后最低净 EV
SNIPER_MIN_EV=0.02
# 贝叶斯最少更新次数
SNIPER_MIN_UPDATES=3
# 同一5分钟窗口最多狙击几个市场
SNIPER_MAX_PER_EPOCH=1

# ── 狙击持仓保护 ──
# 当前ATR≥入场ATR×此值时继续持有
SNIPER_ATR_HOLD_RATIO=0.30
# token跌幅超此值时无条件放行EV止损
SNIPER_LOSS_OVERRIDE=0.35
# 固定保护期（秒），0=关闭
SNIPER_GRACE_SECONDS=15

# 追踪止盈（1=开启, 0=关闭）
TRAILING_TP_ENABLED=1

# ══════════════════════════════════════════════
# 5. 方向确认伏击单（v12.9.1+）
# ══════════════════════════════════════════════

# 1=开启, 0=关闭
SNIPER_AMBUSH=1
# 回退固定价格（动态定价优先）
SNIPER_AMBUSH_PRICE=0.55
# 最低相对ATR偏离
SNIPER_AMBUSH_MIN_ATR=0.5
# 最低绝对ATR（美元）
SNIPER_AMBUSH_MIN_ATR_ABS=20
# 最低贝叶斯置信度
SNIPER_AMBUSH_MIN_CONF=0.25
# 伏击独立shrinkage（maker零手续费，可比taker更信任模型）
SNIPER_AMBUSH_SHRINKAGE=0.85
# 动态定价范围
SNIPER_AMBUSH_MIN_PRICE=0.45
SNIPER_AMBUSH_MAX_PRICE=0.85
# 从公允价值减去的利润空间（含手续费）
SNIPER_AMBUSH_EDGE=0.012
# CLOB感知定价：在ask下方多少挂单
SNIPER_AMBUSH_ASK_OFFSET=0.03
# CLOB感知定价：到期时ask偏移下限（时间衰减：ASK_OFFSET→ASK_OFFSET_MIN）
SNIPER_AMBUSH_ASK_OFFSET_MIN=0.005
# CLOB感知定价：模型价与市场ask差超过此值直接放弃挂单
SNIPER_AMBUSH_MAX_GAP=0.25
# 最大追价次数（v14.2: 5→8，配合GTD缩短提高追价覆盖）
SNIPER_AMBUSH_REPRICE_MAX=8
# 追价最小价差（低于此值不追价）
SNIPER_AMBUSH_REPRICE_MIN_DELTA=0.01
# GTD追价单存活秒数（v14.2: 90→45，实际过期=45+60s安全阈值=105s；追价耗尽后等GTD过期才重置计数器）
SNIPER_AMBUSH_GTD_REPRICE_SEC=45
# 成交后方向校验最低置信度（低于此值立即卖出）
SNIPER_AMBUSH_FILL_MIN_CONF=0.20

# v12.9.16: 伏击止盈单 — 成交后挂GTD SELL限价锁定利润
# 开关（1=开启，0=关闭）
AMBUSH_TP_ENABLED=1
# 止盈价位比例：entry + (1-entry) × RATIO（0.8=取利润空间八成）
AMBUSH_TP_RATIO=0.8
# 到期前多少秒截止止盈单（留足结算缓冲）
AMBUSH_TP_DEADLINE=15

# v13.1: 伏击仓位持有到期 — 跳过中途止损，只保留绝对硬止损兜底
# 开关（1=开启，0=关闭）— v14: 改为分阶段止损，此开关仍控制是否启用伏击专属逻辑
AMBUSH_HOLD_TO_EXPIRY=1
# 伏击仓位绝对硬止损阈值（兜底，任何阶段跌超此值立即退出）
AMBUSH_HARD_STOP=0.70

# v14: 分阶段时间衰减止盈止损（Phased Time-Decay TP/SL）
# --- 阶梯止盈（TP随剩余时间递减）---
AMBUSH_TP_PHASE1_RATIO=0.60
AMBUSH_TP_PHASE2_RATIO=0.55
AMBUSH_TP_PHASE3_RATIO=0.40
AMBUSH_TP_PHASE4_FIXED=0.05
# --- 分阶段止损 ---
AMBUSH_RAPID_SL=0.25
# 中期止损阈值: ①快速窗口内方向✅深亏兜底 ②中期通用止损（v14.3: 0.40→0.35, Step2噪音自适应覆盖①）
AMBUSH_MID_SL=0.35
# v14.3 Step2: 方向✅时额外容忍度（-35%+10%=-45%），120s→60s线性衰减。设0关闭
AMBUSH_NOISE_TOLERANCE=0.10
AMBUSH_LATE_SL=0.30
AMBUSH_RAPID_SL_WINDOW=30
# --- Breakeven锁定 ---
AMBUSH_BREAKEVEN_TRIGGER=0.15
AMBUSH_BREAKEVEN_MARGIN=0.02
# --- 方向确认窗口 ---
AMBUSH_CONFIRM_WINDOW=15
AMBUSH_CONFIRM_THRESHOLD=0.0003

# v13: Smart Ambush — 动态EDGE参数
# 动态EDGE最小值（时间衰减下限）
SNIPER_AMBUSH_EDGE_MIN=0.005
# 平均ATR基准（波动率自适应参照）
SNIPER_AMBUSH_AVG_ATR=30
# OFI逆向选择阈值（订单簿倾斜超过此值跳过挂单）
SNIPER_AMBUSH_OFI_THRESHOLD=0.82

# v13.1 M5: 最低订单簿深度（低于此值跳过伏击）
SNIPER_AMBUSH_MIN_DEPTH=100

# v13.1 M1: Maker Exit（止损先尝试GTD maker卖出，0手续费+返佣）
# 开关（1=开启，0=关闭）
MAKER_EXIT_ENABLED=1
# 最少剩余秒数才尝试maker（低于此直接FAK）
MAKER_EXIT_MIN_REMAINING=30
# maker等待成交秒数（超时切FAK）
MAKER_EXIT_WAIT=8

# v13.1 M2: Endgame entry（尾盘高确定性入场，Monte Carlo P(win)）
# 开关（1=开启，0=关闭）
ENDGAME_ENABLED=1
# 入场窗口（市场开始后秒数）
ENDGAME_TAIL_SEC=60
ENDGAME_TAIL_CUTOFF_SEC=30
# 最低Monte Carlo P(win)
ENDGAME_MIN_P_WIN=0.85
# 最低EV margin
ENDGAME_MIN_EDGE=0.02
# Monte Carlo模拟路径数
ENDGAME_N_PATHS=1000

# ─────────── Oracle Sniper (v14.4) — Tail-segment high-confidence channel ───────────
# Activates in the final 30s before deadline. Uses Chainlink as primary signal
# (gbm_p_up > 0.93 / < 0.07) with Binance 15s reversal cross-validation.
# Two-phase order state machine: 30s-15s maker GTD, 15s-0s taker FAK.
# Spec: docs/superpowers/specs/2026-04-08-oracle-sniper-design.md
ORACLE_SNIPER_ENABLED=1
ORACLE_SNIPER_LIVE=0
ORACLE_SNIPER_TAIL_SEC=30
ORACLE_SNIPER_TAKER_SWITCH_SEC=15
ORACLE_SNIPER_P_UP_THRESHOLD=0.93
ORACLE_SNIPER_CL_STALE_SEC=1.0
ORACLE_SNIPER_BN_WINDOW_SEC=15
ORACLE_SNIPER_BN_REVERSE_BPS=2
ORACLE_SNIPER_COOLDOWN_SEC=5
ORACLE_SNIPER_MAKER_EDGE=0.012
ORACLE_SNIPER_TOO_LATE_SEC=1.0
ORACLE_SNIPER_STATE_PATH=logs/oracle_active_orders.json
ORACLE_SNIPER_LOG_PATH=logs/oracle_sniper.jsonl
ORACLE_SNIPER_MAX_BET_SIZE=
ORACLE_SNIPER_MIN_BET_SIZE=

# ─────────── Endgame window refactor (v14.4) — deadline-anchored ───────────
# Replaces ENDGAME_BET_START / ENDGAME_BET_END (round-start-anchored, deprecated).
# Endgame now runs when (ENDGAME_TAIL_CUTOFF_SEC, ENDGAME_TAIL_SEC] seconds remain.
# If legacy ENDGAME_BET_START/END are set, they're auto-migrated for one release cycle.
# DEPRECATED (auto-migrated for one release cycle; startup logs WARN):
# ENDGAME_BET_START=260
# ENDGAME_BET_END=290

# CL-BN偏差超过此ATR倍数时暂停EV止损
EV_SKEW_BLOCK_ATR=0.7

# ══════════════════════════════════════════════
# 6. 下注决策参数
# ══════════════════════════════════════════════

# 全局门槛
MAX_BUY_PRICE=0.60
MIN_EV=0.03
MIN_CONFIDENCE=0.40

# 分方向覆盖
MAX_BUY_PRICE_UP=0.65
MAX_BUY_PRICE_DOWN=0.65
MIN_EV_UP=0.04
MIN_EV_DOWN=0.04
MIN_CONFIDENCE_UP=0.35
MIN_CONFIDENCE_DOWN=0.35

# ATR偏离门槛（越高越保守）
MIN_ATR_DEVIATION=1.0
# 胜率上限
P_WIN_CAP=0.90
# p_win 收缩系数（模型系统性高估校准）
P_WIN_SHRINKAGE=0.80

# ══════════════════════════════════════════════
# 7. 预热 + 下注窗口
# ══════════════════════════════════════════════

# 预热开始时间（市场开始后秒数）
WARMUP_START_SECONDS=8
# 预热采样间隔（秒）
WARMUP_SAMPLE_INTERVAL_EARLY=2
WARMUP_SAMPLE_INTERVAL_LATE=1

# 早期窗口（CLOB尚未充分定价，token便宜）
EARLY_BET_START=25
EARLY_BET_END=99
EARLY_MIN_SAMPLES=4
EARLY_MIN_EV=0.03
EARLY_MIN_CONFIDENCE=0.35
EARLY_MIN_EV_UP=0.02
EARLY_MIN_EV_DOWN=0.02
EARLY_MIN_CONFIDENCE_UP=0.45
EARLY_MIN_CONFIDENCE_DOWN=0.45

# 晚期窗口（早期未触发时兜底）
LATE_BET_START=100
LATE_BET_END=220
LATE_MIN_UPDATES=3
LATE_LOW_CONF_THRESHOLD=0.15
LATE_GAP_CROSS_ALLOW_CONF=0.60
LATE_MATURE_SAMPLE_COUNT=8
# 重分析冷却间隔（秒）
ENTRY_REANALYZE_INTERVAL=20
LATE_REANALYZE_INTERVAL=20

# ══════════════════════════════════════════════
# 8. EV-Gate 止损（v11）
# ══════════════════════════════════════════════

# 1=开启, 0=关闭（回退到纯ATR止损）
ENABLE_EV_GATE=1
# 连续确认轮数（防单tick噪音）
EV_EXIT_CONFIRMATIONS=2
# P(win) 上下限
EV_P_WIN_CAP=0.95
EV_P_WIN_FLOOR=0.02
# ATR→σ换算比率
EV_ATR_SIGMA_RATIO=1.5
# 断路器：token跌幅超此值强制退出
EV_CIRCUIT_BREAKER_LOSS=0.50
# 断路器：oracle缺失+剩余低于此秒数+已亏>30%→强制退出
EV_CIRCUIT_BREAKER_BLIND_SECS=120

# ══════════════════════════════════════════════
# 9. 止盈系统（P0双曲 + 追踪止盈）
# ══════════════════════════════════════════════

# 基础止盈阈值
P0_BASE_PROFIT=0.50
# 双曲贴现系数
P0_HYPERBOLIC_K=0.10
# 兼容旧版止盈阈值
PROFIT_THRESHOLD=0.2

# ══════════════════════════════════════════════
# 10. 平仓参数
# ══════════════════════════════════════════════

# 空簿回退滑点
SLIPPAGE=0.01
# HTTP超时（秒）
FOK_TIMEOUT=2

# ATR三层止损/抄底
PRICE_DROP_TRIGGER=0.15
PRICE_DROP_HARD_STOP=0.25
# 绝对硬止损（不看方向/EV/ATR）
ABSOLUTE_HARD_STOP=0.50
ATR_SAFE_THRESHOLD=2.0
ATR_DANGER_THRESHOLD=1.0
# 抄底加仓量=原仓位×此比例
DIP_BUY_SIZE_RATIO=0.5
# 剩余时间低于此秒数不抄底
DIP_BUY_MIN_REMAINING=60

# ATR衰减止损
ATR_DECAY_EXIT_THRESHOLD=0.15
ATR_DECAY_RATIO=0.25
ATR_DIRECTION_CORRECT_STOP=0.5
# 连续确认次数（防插针误杀）
ATR_DECAY_CONFIRMATIONS=3

# PTB Proximity Buffer（crypto临近PTB时冻结方向信号）
PTB_PROXIMITY_ATR=0.45
PTB_PROXIMITY_EXTREME_STOP=0.25

# ══════════════════════════════════════════════
# 11. 波动触发重分析
# ══════════════════════════════════════════════

# 价格波动超过此ATR倍数时重分析
REANALYZE_ATR_MULT=1.5
# 重分析冷却（秒）
REANALYZE_COOLDOWN=15
# 每个市场最多重分析次数
MAX_REANALYZE=3
# 晚期窗口最大分析次数
MAX_TRADE_RETRIES=5

# ══════════════════════════════════════════════
# ── 17. Direction Truth Gate (v15.0) ──
# 三源 GBM 隐含概率交叉验证 + 2/3 多数决方向真值闸门
# 详见 docs/superpowers/specs/2026-04-07-direction-truth-gate-design.md
# ══════════════════════════════════════════════

# 闸门总开关：1=启用，0=完全跳过（回退老逻辑）
DIR_TRUTH_GATE_ENABLED=1
# Shadow 模式：1=只记日志不真拦截（默认开，灰度首选）；0=实盘拦截
DIR_TRUTH_SHADOW=1
# 单源 stale 阈值（秒）—— 超过此值认为该源数据失效
DIR_TRUTH_STALE_CL_SEC=30
DIR_TRUTH_STALE_BN_SEC=5
DIR_TRUTH_STALE_PYTH_SEC=30
# 单源投票概率阈值（GBM 算出 p_up 后比这俩判 UP/DOWN/NEUTRAL）
DIR_TRUTH_VOTE_UP_P=0.55
DIR_TRUTH_VOTE_DOWN_P=0.45
# 闸门 confidence 收缩系数（独立于 P_WIN_SHRINKAGE，避免双重打折）
DIR_TRUTH_SHRINKAGE=0.85

# ══════════════════════════════════════════════
# ── 18. Exit Truth Gate (v15.1) ──
# 三层错杀防护：在 EV 止损执行前最后一道闸门
# 数据驱动：4 月 6-7 日复盘显示 75% 的完整 EV 止损是错杀
# 三层 OR 组合（任一层触发即拦截）：
#   1. P_win 硬地板：贝叶斯模型自己说赢，不该止损
#   2. 尾盘锁仓：剩余 30s 内禁止止损（让 dice 落地）
#   3. DTG 三源共识：方向闸门 2/3 源仍同意持仓方向
# 详见 ai_trader/exit_truth_gate.py
# ══════════════════════════════════════════════

# 出场闸门总开关：1=启用，0=完全跳过（回退老逻辑）
EXIT_GATE_ENABLED=1
# Shadow 模式：1=只记日志不真拦截，0=实盘拦截
# 代码默认 1（保守）；本仓库默认 0（owner 选择激进，跳过 shadow 阶段直接实盘）
# 新用户复制本文件后请评估自己的风险偏好后再决定是否切回 1
EXIT_GATE_SHADOW=0
# Layer 1: P_win 硬地板（高于此值时永不止损）
EXIT_GATE_PWIN_FLOOR=0.75
# Layer 2: 尾盘锁仓秒数（剩余少于此值时永不止损）
# 代码默认 30；本仓库 owner 调到 10，依赖 Layer 1 (P_win > 0.75) 兜底大部分错杀场景
EXIT_GATE_NEAR_EXPIRY_SEC=10
