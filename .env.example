# ──────────────────────────────────────────────
# Polymarket Trading Bot - 环境变量模板
# 复制本文件为 .env 并填入真实值:  cp .env.example .env
# ──────────────────────────────────────────────

# Telegram 通知（可选，留空则不发通知）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 钱包地址（必填）
# EOA_WALLET:   签名用的 EOA 地址
# PROXY_WALLET: Polymarket 代理钱包（持仓实际存储地址，官网 Settings 里查看）
EOA_WALLET=0xYourEOAWalletAddress
PROXY_WALLET=0xYourProxyWalletAddress

# SDK 签名类型（影响下单和资金来源）
# 0 = EOA 直签（资金在 EOA 钱包，默认）
# 1 = POLY_PROXY（Magic / 邮箱登录，资金在官网 Proxy 钱包）
# 2 = GNOSIS_SAFE（浏览器钱包登录官网，资金在官网 Proxy 钱包，常见）
CLOB_SIGNATURE_TYPE=0

# 链上结算 + SDK直连下单（PRIVATE_KEY 同时用于 CLOB SDK 签名）
PRIVATE_KEY=0xYourPrivateKey
POLYGON_RPC_URL=https://polygon.api.onfinality.io/public

# 自动兑换轮询间隔（秒），默认600（10分钟）
REDEEM_INTERVAL=600

# ── 币种配置 ──
# 启用的交易币种（逗号分隔，可选: BTC,ETH,BNB）
# 每个币种对应一个 Polymarket 5分钟 up/down 市场
# 数据源自动适配: Binance WS + Chainlink RTDS + Pyth SSE
ENABLED_COINS=BTC,ETH,BNB

# ── 价格数据源 ──
# 1 = Chainlink优先（官方结算价，Polymarket直接使用，默认推荐）
# 2 = Pyth优先（链上预言机，延迟略高但独立于Polymarket）
# 无论选哪个，另一个都作为fallback，最终fallback为Binance
PRICE_SOURCE=1

# ── 风险控制 ──
MAX_DAILY_LOSS=10.0
MAX_OPEN_POSITIONS=2
MIN_BALANCE=3.0

# Kelly 仓位上下限（份数）
# Kelly公式根据余额和信号强度自动算出份数，MIN/MAX 夹住
# 默认5-10；加资金后调高 MAX_BET_SIZE 即可放大仓位
# MAX_ENTRY_BALANCE_PCT: 单笔入场最多占用余额比例（默认20%）
MIN_BET_SIZE=5
MAX_BET_SIZE=10
MAX_ENTRY_BALANCE_PCT=0.20

# ── 下注决策 ──
# 统一阈值（未配置方向化参数时使用）
MAX_BUY_PRICE=0.95
MIN_EV=0.06
MIN_CONFIDENCE=0.50
# 可选：分方向覆盖（优先级高于统一阈值）
# 示例：若做 BTC-only，可把 DOWN 配得更保守
# MAX_BUY_PRICE_UP=0.85
# MAX_BUY_PRICE_DOWN=0.79
# MIN_EV_UP=0.04
# MIN_EV_DOWN=0.08
# MIN_CONFIDENCE_UP=0.50
# MIN_CONFIDENCE_DOWN=0.62
MIN_ATR_DEVIATION=1.2
# 胜率上限（同时控制分析阶段和 Kelly 仓位计算，防止贝叶斯累积推高 p_win）
P_WIN_CAP=0.95

# ── 下注窗口 ──
# 早期窗口：CLOB尚未充分定价时抢先入场（EV门槛可低于正常窗口）
EARLY_BET_START=80
EARLY_BET_END=95
EARLY_MIN_EV=0.03
EARLY_MIN_CONFIDENCE=0.50
# 可选：早期窗口也可按方向覆盖
# EARLY_MIN_EV_UP=0.03
# EARLY_MIN_EV_DOWN=0.05
# EARLY_MIN_CONFIDENCE_UP=0.38
# EARLY_MIN_CONFIDENCE_DOWN=0.50
# Spread成本折算：提前平仓(止盈/止损/强制)的概率，持有到期不付spread
# 0.3=30%仓位提前退出，实际spread_cost = raw_spread × 此值
EARLY_EXIT_RATIO=0.3
# 晚期窗口：早期未触发时兜底
LATE_BET_START=100
LATE_BET_END=200
# 晚期窗口分析拒绝后的重分析冷却间隔（秒）
# 在此期间贝叶斯后验持续更新，冷却到期后用新数据重新分析
LATE_REANALYZE_INTERVAL=20

# ── 平仓参数 ──
# 空簿回退滑点（last-trade-price ± SLIPPAGE，默认0.01）
SLIPPAGE=0.01

# P0 双曲贴现止盈
# 实际阈值 = BASE_PROFIT × (1 + K × 剩余分钟数)
# 首次达标跳过等$1结算条件：方向正确 + ≥3ATR + 剩余>90s
P0_BASE_PROFIT=0.20
PROFIT_THRESHOLD=0.15
P0_HYPERBOLIC_K=0.15

# HTTP 超时（秒，影响所有 CLOB API 调用）
FOK_TIMEOUT=3

# ATR 三层止损/抄底决策
# token跌幅触发线（从入场价算）
PRICE_DROP_TRIGGER=0.15
# 硬止损线：无论ATR/方向，跌≥此值强制止损
PRICE_DROP_HARD_STOP=0.25
# ATR偏离安全阈值（≥此值=抄底区）
ATR_SAFE_THRESHOLD=2.0
# ATR偏离危险阈值（<此值=止损区）
ATR_DANGER_THRESHOLD=1.0
# 抄底加仓量 = 原仓位 × 此比例
DIP_BUY_SIZE_RATIO=0.50
# 剩余时间低于此秒数不抄底
DIP_BUY_MIN_REMAINING=60

# ATR 衰减止损（基于Chainlink实时价格，crypto逼近PTB时提前退出）
# ATR降到此值以下触发（crypto离PTB很近）
ATR_DECAY_EXIT_THRESHOLD=0.5
# ATR降到入场值的此比例以下触发（如入场2.0ATR降到0.5=衰减75%）
ATR_DECAY_RATIO=0.30
# 方向正确但ATR<此值 + token跌>20% → 也触发止损（50:50不值得持有）
ATR_DIRECTION_CORRECT_STOP=0.5

# PTB Proximity Buffer（crypto在PTB附近时冻结方向信号，防止噪音触发止损）
# 当 abs(crypto-PTB)/ATR < 此阈值时，视为噪音区，不触发方向类止损
# 阈值随时间衰减：前2分钟=0.7ATR → 中段线性降至0.3ATR → 最后1分钟=0.15ATR
PTB_PROXIMITY_ATR=0.7
# proximity zone 内的极端安全阀：token跌幅超过此值时强制解除保护
PTB_PROXIMITY_EXTREME_STOP=0.50

# ── 波动触发重分析 ──
# 跳过的市场（低信心等）若价格波动超过ATR倍数，重新进入分析
REANALYZE_ATR_MULT=1.5
# 重分析冷却时间（秒）
REANALYZE_COOLDOWN=15
# 每个市场最多重分析次数（波动触发）
MAX_REANALYZE=1
# 晚期窗口最大分析次数（含分析拒绝+FOK重试，建议≥5覆盖完整窗口）
MAX_TRADE_RETRIES=5


# ATR衰减止损需要连续确认，防止单点插针误杀
ATR_DECAY_CONFIRMATIONS=3

# 默认关闭方向降级；不要再把“底层方向其实正确”的单子强行降级成错误
ENABLE_DIRECTION_DOWNGRADE=0

# 只有以后重新开启方向降级时才有意义
ATR_DOWNGRADE_THRESHOLD=0.15
