# ──────────────────────────────────────────────────────────────
# Polymarket Trading Bot v12.9.12 - Environment Variables Template
# Copy this file to .env and fill in your real values:  cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════
# 1. Credentials (required)
# ══════════════════════════════════════════════

# Telegram notifications (optional, leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Wallet addresses (required)
EOA_WALLET=0xYourEOAWalletAddress
PROXY_WALLET=0xYourProxyWalletAddress

# SDK signature type
# 0 = EOA direct sign (funds in EOA wallet)
# 1 = POLY_PROXY (Magic / email login, funds in Proxy wallet)
# 2 = GNOSIS_SAFE (browser wallet login, funds in Proxy wallet, most common)
CLOB_SIGNATURE_TYPE=2

# Private key + RPC (required for CLOB SDK signing and on-chain redeem)
PRIVATE_KEY=0xYourPrivateKey
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Relayer free-gas settlement (optional, falls back to self-paid gas)
RELAYER_API_KEY=your-relayer-api-key-uuid

# Auto redeem polling interval (seconds)
REDEEM_INTERVAL=300

# ══════════════════════════════════════════════
# 2. Coins & Data Sources
# ══════════════════════════════════════════════

# Enabled trading coins (comma-separated, options: BTC,ETH,BNB,SOL,HYPE,DOGE,XRP)
ENABLED_COINS=BTC

# Price data source priority
# 1 = Chainlink first (official settlement price, recommended)
# 2 = Pyth first (on-chain oracle, independent of Polymarket)
PRICE_SOURCE=1

# ══════════════════════════════════════════════
# 3. Risk Control
# ══════════════════════════════════════════════

MAX_DAILY_LOSS=25.0
MAX_OPEN_POSITIONS=2
MIN_BALANCE=5.0

# Kelly position sizing (share count)
MIN_BET_SIZE=5
MAX_BET_SIZE=15
# Max single entry as fraction of balance
MAX_ENTRY_BALANCE_PCT=0.20

# ══════════════════════════════════════════════
# 4. Sniper Thread (v12.6+)
# ══════════════════════════════════════════════

# Max acceptable CLOB ask price
SNIPER_MAX_PRICE=0.65
# Min ATR deviation to trigger sniper
SNIPER_MIN_ATR=0.8
# Independent p_win shrinkage (more conservative than global)
SNIPER_P_WIN_SHRINKAGE=0.70
# Min net EV after fees/spread
SNIPER_MIN_EV=0.02
# Min Bayesian updates before sniper can fire
SNIPER_MIN_UPDATES=4
# Max sniper entries per 5-min epoch
SNIPER_MAX_PER_EPOCH=1

# ── Sniper hold protection ──
# Hold while current ATR >= entry ATR × this ratio
SNIPER_ATR_HOLD_RATIO=0.30
# Token drop beyond this overrides ATR protection
SNIPER_LOSS_OVERRIDE=0.35
# Fixed grace period (seconds), 0=disabled (let EV+TrailingTP handle)
SNIPER_GRACE_SECONDS=15

# Trailing Take-Profit (1=on, 0=off)
TRAILING_TP_ENABLED=1

# ══════════════════════════════════════════════
# 5. Directional Ambush Orders (v12.9.1+)
# ══════════════════════════════════════════════

# 1=enabled, 0=disabled
SNIPER_AMBUSH=1
# Fallback fixed price (dynamic pricing overrides this)
SNIPER_AMBUSH_PRICE=0.55
# Min relative ATR deviation
SNIPER_AMBUSH_MIN_ATR=0.8
# Min absolute ATR (USD)
SNIPER_AMBUSH_MIN_ATR_ABS=25
# Min Bayesian confidence
SNIPER_AMBUSH_MIN_CONF=0.25
# Dynamic pricing range
SNIPER_AMBUSH_MIN_PRICE=0.50
SNIPER_AMBUSH_MAX_PRICE=0.75
# Edge subtracted from fair value (includes fees)
SNIPER_AMBUSH_EDGE=0.025
# CLOB-aware pricing: place order at ask minus this offset
SNIPER_AMBUSH_ASK_OFFSET=0.05
# CLOB-aware pricing: skip if model-to-market gap exceeds this
SNIPER_AMBUSH_MAX_GAP=0.15
# Max reprice attempts per market
SNIPER_AMBUSH_REPRICE_MAX=10
# Min price change to trigger reprice
SNIPER_AMBUSH_REPRICE_MIN_DELTA=0.01
# GTD reprice order TTL (seconds)
SNIPER_AMBUSH_GTD_REPRICE_SEC=60
# Post-fill direction validation min confidence
SNIPER_AMBUSH_FILL_MIN_CONF=0.25

# CL-BN skew protection: pause EV stop-loss when CL lags BN by this ATR
EV_SKEW_BLOCK_ATR=0.7

# ══════════════════════════════════════════════
# 6. Entry Decision Parameters
# ══════════════════════════════════════════════

# Global thresholds
MAX_BUY_PRICE=0.60
MIN_EV=0.03
MIN_CONFIDENCE=0.40

# Per-direction overrides
MAX_BUY_PRICE_UP=0.65
MAX_BUY_PRICE_DOWN=0.65
MIN_EV_UP=0.04
MIN_EV_DOWN=0.04
MIN_CONFIDENCE_UP=0.35
MIN_CONFIDENCE_DOWN=0.35

# Min ATR deviation (higher = more conservative)
MIN_ATR_DEVIATION=1.0
# p_win cap and shrinkage
P_WIN_CAP=0.90
P_WIN_SHRINKAGE=0.80

# ══════════════════════════════════════════════
# 7. Warmup + Betting Windows
# ══════════════════════════════════════════════

WARMUP_START_SECONDS=8
WARMUP_SAMPLE_INTERVAL_EARLY=2
WARMUP_SAMPLE_INTERVAL_LATE=1

# Early window (CLOB not fully priced, cheaper tokens)
EARLY_BET_START=25
EARLY_BET_END=99
EARLY_MIN_SAMPLES=4
EARLY_MIN_EV=0.03
EARLY_MIN_CONFIDENCE=0.35
EARLY_MIN_EV_UP=0.02
EARLY_MIN_EV_DOWN=0.02
EARLY_MIN_CONFIDENCE_UP=0.45
EARLY_MIN_CONFIDENCE_DOWN=0.45
EARLY_EXIT_RATIO=0.3

# Late window (fallback when early didn't trigger)
LATE_BET_START=100
LATE_BET_END=220
LATE_MIN_UPDATES=3
LATE_LOW_CONF_THRESHOLD=0.15
LATE_GAP_CROSS_ALLOW_CONF=0.60
LATE_MATURE_SAMPLE_COUNT=8
ENTRY_REANALYZE_INTERVAL=20
LATE_REANALYZE_INTERVAL=20

# ══════════════════════════════════════════════
# 8. EV-Gate Stop-Loss (v11)
# ══════════════════════════════════════════════

ENABLE_EV_GATE=1
EV_EXIT_CONFIRMATIONS=2
EV_P_WIN_CAP=0.95
EV_P_WIN_FLOOR=0.02
EV_ATR_SIGMA_RATIO=1.5
# Circuit breaker: force exit when token drops beyond this
EV_CIRCUIT_BREAKER_LOSS=0.50
EV_CIRCUIT_BREAKER_BLIND_SECS=120

# ══════════════════════════════════════════════
# 9. Take-Profit (P0 Hyperbolic + Trailing TP)
# ══════════════════════════════════════════════

P0_BASE_PROFIT=0.50
P0_HYPERBOLIC_K=0.10
PROFIT_THRESHOLD=0.2

# ══════════════════════════════════════════════
# 10. Exit Parameters
# ══════════════════════════════════════════════

SLIPPAGE=0.01
FOK_TIMEOUT=2

# ATR 3-layer stop-loss / dip-buy
PRICE_DROP_TRIGGER=0.15
PRICE_DROP_HARD_STOP=0.25
ABSOLUTE_HARD_STOP=0.50
ATR_SAFE_THRESHOLD=2.0
ATR_DANGER_THRESHOLD=1.0
DIP_BUY_SIZE_RATIO=0.5
DIP_BUY_MIN_REMAINING=60

# ATR decay stop-loss
ATR_DECAY_EXIT_THRESHOLD=0.15
ATR_DECAY_RATIO=0.25
ATR_DIRECTION_CORRECT_STOP=0.5
ATR_DECAY_CONFIRMATIONS=3

# PTB Proximity Buffer
PTB_PROXIMITY_ATR=0.45
PTB_PROXIMITY_EXTREME_STOP=0.25

# ══════════════════════════════════════════════
# 11. Volatility Re-Analysis
# ══════════════════════════════════════════════

REANALYZE_ATR_MULT=1.5
REANALYZE_COOLDOWN=15
MAX_REANALYZE=3
MAX_TRADE_RETRIES=5

# Direction downgrade (default off)
ENABLE_DIRECTION_DOWNGRADE=0
ATR_DOWNGRADE_THRESHOLD=0.15
