# ──────────────────────────────────────────────
# Polymarket Trading Bot - 环境变量模板
# 复制本文件为 .env 并填入真实值:  cp .env.example .env
# ──────────────────────────────────────────────

# Telegram 通知（可选，留空则不发通知）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 钱包地址（必填）
# EOA_WALLET:   签名用的 EOA 地址
# PROXY_WALLET: Polymarket 代理钱包（持仓实际存储地址，官网 Settings 里查看）
EOA_WALLET=0xYourEOAWalletAddress
PROXY_WALLET=0xYourProxyWalletAddress

# SDK 签名类型（影响下单和资金来源）
# 0 = EOA 直签（资金在 EOA 钱包，默认）
# 1 = POLY_GNOSIS_SAFE（资金在官网 Proxy 钱包）
CLOB_SIGNATURE_TYPE=0

# 链上结算 + SDK直连下单（PRIVATE_KEY 同时用于 CLOB SDK 签名）
PRIVATE_KEY=0xYourPrivateKey
POLYGON_RPC_URL=https://polygon.api.onfinality.io/public

# 自动兑换轮询间隔（秒），默认600（10分钟）
REDEEM_INTERVAL=600

# 风险控制参数
MAX_DAILY_LOSS=10.0
MAX_OPEN_POSITIONS=2
MIN_BALANCE=3.0

# 挂单对账参数（LIVE挂单后续成交补登记持仓）
# PENDING_ORDER_TTL: 挂单等待时长（秒），超时自动取消
# PENDING_MIN_FILL: 最小成交份数，达到该值才认定为入仓
PENDING_ORDER_TTL=120
PENDING_MIN_FILL=0.5

# Kelly 仓位上下限（份数）
# Kelly公式根据余额和信号强度自动算出份数，MIN/MAX 夹住
# 默认5-10向后兼容；加资金后调高 MAX_BET_SIZE 即可放大仓位
MIN_BET_SIZE=5
MAX_BET_SIZE=10

# 下注决策参数
MAX_BUY_PRICE=0.96
MIN_EV=0.06
MIN_CONFIDENCE=0.50
MIN_ATR_DEVIATION=1.4
# 胜率上限（同时控制分析阶段和 Kelly 仓位计算，防止贝叶斯累积推高 p_win）
P_WIN_CAP=0.95

# 下注窗口时间（秒，从市场开始计算）
# 早期窗口：CLOB尚未充分定价时抢先入场（门槛更低）
EARLY_BET_START=80
EARLY_BET_END=95
EARLY_MIN_EV=0.06
EARLY_MIN_CONFIDENCE=0.50
# Spread成本折算：提前平仓(止盈/止损/强制)的概率，持有到期不付spread
# 0.3=30%仓位提前退出，实际spread_cost = raw_spread × 此值
EARLY_EXIT_RATIO=0.3
# 晚期窗口：早期未触发时兜底
LATE_BET_START=100
LATE_BET_END=160

# 空簿回退滑点（last-trade-price ± SLIPPAGE，默认0.01）
SLIPPAGE=0.01

# P0 双曲贴现止盈参数
# BASE_PROFIT: 基础止盈阈值（默认0.20=20%）
# HYPERBOLIC_K: 双曲贴现系数，越大则远期要求越高（默认0.15）
# 实际阈值 = BASE_PROFIT × (1 + K × 剩余分钟数)
# PROFIT_THRESHOLD: 止盈基准阈值（默认0.15=15%），P0_BASE_PROFIT 不填时会跟随它
P0_BASE_PROFIT=0.20
PROFIT_THRESHOLD=0.15
P0_HYPERBOLIC_K=0.15

# 交易币种（逗号分隔，默认BTC,ETH）
# 添加新币种只需在此列表追加，如 BTC,ETH,BNB
TRADING_COINS=BTC,ETH
