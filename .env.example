# ──────────────────────────────────────────────────────────────
# Polymarket Trading Bot v12.9.12 - 环境变量模板
# 复制本文件为 .env 并填入真实值:  cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════
# 1. 基础配置（必填）
# ══════════════════════════════════════════════

# Telegram 通知（可选，留空则不发通知）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 钱包地址（必填）
EOA_WALLET=0xYourEOAWalletAddress
PROXY_WALLET=0xYourProxyWalletAddress

# SDK 签名类型
# 0 = EOA 直签（资金在 EOA 钱包）
# 1 = POLY_PROXY（Magic/邮箱登录，资金在 Proxy 钱包）
# 2 = GNOSIS_SAFE（浏览器钱包登录，资金在 Proxy 钱包，最常见）
CLOB_SIGNATURE_TYPE=2

# 私钥 + RPC（CLOB SDK 签名 + 链上兑换）
PRIVATE_KEY=0xYourPrivateKey
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Relayer 免 gas 结算（可选，不填则自付 gas）
RELAYER_API_KEY=your-relayer-api-key-uuid

# 自动兑换轮询间隔（秒）
REDEEM_INTERVAL=300

# ══════════════════════════════════════════════
# 2. 交易币种 & 数据源
# ══════════════════════════════════════════════

# 启用的交易币种（逗号分隔，可选: BTC,ETH,BNB,SOL,HYPE,DOGE,XRP）
ENABLED_COINS=BTC

# 价格数据源优先级
# 1 = Chainlink优先（官方结算价，推荐）
# 2 = Pyth优先（链上预言机，独立于Polymarket）
PRICE_SOURCE=1

# ══════════════════════════════════════════════
# 3. 风险控制
# ══════════════════════════════════════════════

# 日亏损上限（美元），超过后当日停止开仓
MAX_DAILY_LOSS=25.0
# 最大同时持仓数
MAX_OPEN_POSITIONS=2
# 最低余额保护（美元）
MIN_BALANCE=5.0

# Kelly 仓位上下限（份数）
MIN_BET_SIZE=5
MAX_BET_SIZE=15
# 单笔入场最多占用余额比例
MAX_ENTRY_BALANCE_PCT=0.20

# ══════════════════════════════════════════════
# 4. 狙击线程（v12.6+）
# ══════════════════════════════════════════════

# 最高可接受 CLOB ask 价格
SNIPER_MAX_PRICE=0.65
# 最小 ATR 偏离倍数
SNIPER_MIN_ATR=0.8
# 独立 p_win 收缩系数（比全局更保守）
SNIPER_P_WIN_SHRINKAGE=0.70
# 扣费后最低净 EV
SNIPER_MIN_EV=0.02
# 贝叶斯最少更新次数
SNIPER_MIN_UPDATES=4
# 同一5分钟窗口最多狙击几个市场
SNIPER_MAX_PER_EPOCH=1

# ── 狙击持仓保护 ──
# 当前ATR≥入场ATR×此值时继续持有
SNIPER_ATR_HOLD_RATIO=0.30
# token跌幅超此值时无条件放行EV止损
SNIPER_LOSS_OVERRIDE=0.35
# 固定保护期（秒），0=关闭
SNIPER_GRACE_SECONDS=15

# 追踪止盈（1=开启, 0=关闭）
TRAILING_TP_ENABLED=1

# ══════════════════════════════════════════════
# 5. 方向确认伏击单（v12.9.1+）
# ══════════════════════════════════════════════

# 1=开启, 0=关闭
SNIPER_AMBUSH=1
# 回退固定价格（动态定价优先）
SNIPER_AMBUSH_PRICE=0.55
# 最低相对ATR偏离
SNIPER_AMBUSH_MIN_ATR=0.8
# 最低绝对ATR（美元）
SNIPER_AMBUSH_MIN_ATR_ABS=25
# 最低贝叶斯置信度
SNIPER_AMBUSH_MIN_CONF=0.25
# 动态定价范围
SNIPER_AMBUSH_MIN_PRICE=0.50
SNIPER_AMBUSH_MAX_PRICE=0.75
# 从公允价值减去的利润空间（含手续费）
SNIPER_AMBUSH_EDGE=0.025
# CLOB感知定价：在ask下方多少挂单
SNIPER_AMBUSH_ASK_OFFSET=0.05
# CLOB感知定价：模型价与市场ask差超过此值直接放弃挂单
SNIPER_AMBUSH_MAX_GAP=0.15
# 最大追价次数
SNIPER_AMBUSH_REPRICE_MAX=10
# 追价最小价差（低于此值不追价）
SNIPER_AMBUSH_REPRICE_MIN_DELTA=0.01
# GTD追价单存活秒数
SNIPER_AMBUSH_GTD_REPRICE_SEC=60
# 成交后方向校验最低置信度（低于此值立即卖出）
SNIPER_AMBUSH_FILL_MIN_CONF=0.25

# CL-BN偏差超过此ATR倍数时暂停EV止损
EV_SKEW_BLOCK_ATR=0.7

# ══════════════════════════════════════════════
# 6. 下注决策参数
# ══════════════════════════════════════════════

# 全局门槛
MAX_BUY_PRICE=0.60
MIN_EV=0.03
MIN_CONFIDENCE=0.40

# 分方向覆盖
MAX_BUY_PRICE_UP=0.65
MAX_BUY_PRICE_DOWN=0.65
MIN_EV_UP=0.04
MIN_EV_DOWN=0.04
MIN_CONFIDENCE_UP=0.35
MIN_CONFIDENCE_DOWN=0.35

# ATR偏离门槛（越高越保守）
MIN_ATR_DEVIATION=1.0
# 胜率上限
P_WIN_CAP=0.90
# p_win 收缩系数（模型系统性高估校准）
P_WIN_SHRINKAGE=0.80

# ══════════════════════════════════════════════
# 7. 预热 + 下注窗口
# ══════════════════════════════════════════════

# 预热开始时间（市场开始后秒数）
WARMUP_START_SECONDS=8
# 预热采样间隔（秒）
WARMUP_SAMPLE_INTERVAL_EARLY=2
WARMUP_SAMPLE_INTERVAL_LATE=1

# 早期窗口（CLOB尚未充分定价，token便宜）
EARLY_BET_START=25
EARLY_BET_END=99
EARLY_MIN_SAMPLES=4
EARLY_MIN_EV=0.03
EARLY_MIN_CONFIDENCE=0.35
EARLY_MIN_EV_UP=0.02
EARLY_MIN_EV_DOWN=0.02
EARLY_MIN_CONFIDENCE_UP=0.45
EARLY_MIN_CONFIDENCE_DOWN=0.45
# 提前平仓概率（spread成本折算用）
EARLY_EXIT_RATIO=0.3

# 晚期窗口（早期未触发时兜底）
LATE_BET_START=100
LATE_BET_END=220
LATE_MIN_UPDATES=3
LATE_LOW_CONF_THRESHOLD=0.15
LATE_GAP_CROSS_ALLOW_CONF=0.60
LATE_MATURE_SAMPLE_COUNT=8
# 重分析冷却间隔（秒）
ENTRY_REANALYZE_INTERVAL=20
LATE_REANALYZE_INTERVAL=20

# ══════════════════════════════════════════════
# 8. EV-Gate 止损（v11）
# ══════════════════════════════════════════════

# 1=开启, 0=关闭（回退到纯ATR止损）
ENABLE_EV_GATE=1
# 连续确认轮数（防单tick噪音）
EV_EXIT_CONFIRMATIONS=2
# P(win) 上下限
EV_P_WIN_CAP=0.95
EV_P_WIN_FLOOR=0.02
# ATR→σ换算比率
EV_ATR_SIGMA_RATIO=1.5
# 断路器：token跌幅超此值强制退出
EV_CIRCUIT_BREAKER_LOSS=0.50
# 断路器：oracle缺失+剩余低于此秒数+已亏>30%→强制退出
EV_CIRCUIT_BREAKER_BLIND_SECS=120

# ══════════════════════════════════════════════
# 9. 止盈系统（P0双曲 + 追踪止盈）
# ══════════════════════════════════════════════

# 基础止盈阈值
P0_BASE_PROFIT=0.50
# 双曲贴现系数
P0_HYPERBOLIC_K=0.10
# 兼容旧版止盈阈值
PROFIT_THRESHOLD=0.2

# ══════════════════════════════════════════════
# 10. 平仓参数
# ══════════════════════════════════════════════

# 空簿回退滑点
SLIPPAGE=0.01
# HTTP超时（秒）
FOK_TIMEOUT=2

# ATR三层止损/抄底
PRICE_DROP_TRIGGER=0.15
PRICE_DROP_HARD_STOP=0.25
# 绝对硬止损（不看方向/EV/ATR）
ABSOLUTE_HARD_STOP=0.50
ATR_SAFE_THRESHOLD=2.0
ATR_DANGER_THRESHOLD=1.0
# 抄底加仓量=原仓位×此比例
DIP_BUY_SIZE_RATIO=0.5
# 剩余时间低于此秒数不抄底
DIP_BUY_MIN_REMAINING=60

# ATR衰减止损
ATR_DECAY_EXIT_THRESHOLD=0.15
ATR_DECAY_RATIO=0.25
ATR_DIRECTION_CORRECT_STOP=0.5
# 连续确认次数（防插针误杀）
ATR_DECAY_CONFIRMATIONS=3

# PTB Proximity Buffer（crypto临近PTB时冻结方向信号）
PTB_PROXIMITY_ATR=0.45
PTB_PROXIMITY_EXTREME_STOP=0.25

# ══════════════════════════════════════════════
# 11. 波动触发重分析
# ══════════════════════════════════════════════

# 价格波动超过此ATR倍数时重分析
REANALYZE_ATR_MULT=1.5
# 重分析冷却（秒）
REANALYZE_COOLDOWN=15
# 每个市场最多重分析次数
MAX_REANALYZE=3
# 晚期窗口最大分析次数
MAX_TRADE_RETRIES=5

# 方向降级（默认关闭）
ENABLE_DIRECTION_DOWNGRADE=0
ATR_DOWNGRADE_THRESHOLD=0.15
