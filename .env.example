# ──────────────────────────────────────────────
# Polymarket Trading Bot - 环境变量模板
# 复制本文件为 .env 并填入真实值:  cp .env.example .env
# ──────────────────────────────────────────────

# Telegram 通知（可选，留空则不发通知）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 钱包地址（必填）
# EOA_WALLET:   签名用的 EOA 地址（polymarket wallet address 输出）
# PROXY_WALLET: Polymarket 代理钱包（持仓实际存储地址）
# 可通过 `polymarket wallet show` 查看
EOA_WALLET=0xYourEOAWalletAddress
PROXY_WALLET=0xYourProxyWalletAddress
SIGNATURE_TYPE=eoa

# 链上结算所需（auto_redeem_v2 v3.0）
PRIVATE_KEY=0xYourPrivateKey
POLYGON_RPC_URL=https://polygon.api.onfinality.io/public

# 自动兑换轮询间隔（秒），默认600（10分钟）
REDEEM_INTERVAL=600

# 风险控制参数
MAX_DAILY_LOSS=10.0
MAX_OPEN_POSITIONS=2
MIN_BALANCE=5.0

# 下注决策参数
MAX_BUY_PRICE=0.92
MIN_EV=0.05
MIN_CONFIDENCE=0.60
MIN_ATR_DEVIATION=1.5
P_WIN_CAP=0.92

# 下注窗口时间（秒，从市场开始计算）
# 早期窗口：CLOB尚未充分定价时抢先入场（门槛更低）
EARLY_BET_START=40
EARLY_BET_END=95
EARLY_MIN_EV=0.03
EARLY_MIN_CONFIDENCE=0.40
# 晚期窗口：早期未触发时兜底
LATE_BET_START=100
LATE_BET_END=160

# 空簿回退滑点（last-trade-price ± SLIPPAGE，默认0.01）
SLIPPAGE=0.05

# P0 双曲贴现止盈参数
# BASE_PROFIT: 基础止盈阈值（默认0.20=20%）
# HYPERBOLIC_K: 双曲贴现系数，越大则远期要求越高（默认0.15）
# 实际阈值 = BASE_PROFIT × (1 + K × 剩余分钟数)
# PROFIT_THRESHOLD: 止盈基准阈值（默认0.15=15%），P0_BASE_PROFIT 不填时会跟随它
P0_BASE_PROFIT=0.15
PROFIT_THRESHOLD=0.15
P0_HYPERBOLIC_K=0.15
